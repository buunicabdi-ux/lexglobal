rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin whitelist
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Public Knowledge Base (Read-only for all, write for admin)
    match /sources/{sourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /documents/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /treaties/{treatyId} {
      allow read: if true;
      allow write: if isAdmin();

      match /provisions/{provisionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /cases/{caseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /legalConcepts/{conceptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Research Queries & Answers
    match /researchQueries/{queryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /researchAnswers/{answerId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Bookmarks
    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Uploaded Documents
    match /uploadedDocuments/{docId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
